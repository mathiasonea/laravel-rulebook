{
    "name": "mathiasonea/laravel-rulebook",
    "description": "A Laravel package for selecting which code-defined business rule applies to a subject at any point in time—and explaining why.",
    "keywords": [
        "business-rules",
        "effective-dates",
        "eligibility",
        "explainable-decisions",
        "laravel",
        "pricing",
        "rule-resolution",
        "temporal-rules"
    ],
    "homepage": "https://mathiasonea.com/en/open-source/laravel-rulebook",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias Onea",
            "email": "office@mathiasonea.at",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/mathiasonea/laravel-rulebook/issues",
        "forum": "https://github.com/mathiasonea/laravel-rulebook/discussions",
        "source": "https://github.com/mathiasonea/laravel-rulebook",
        "docs": "https://github.com/mathiasonea/laravel-rulebook#readme",
        "security": "https://github.com/mathiasonea/laravel-rulebook/security/policy"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MathiasOnea\\Rulebook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MathiasOnea\\Rulebook\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/TestingDomain.php",
            "tests/Fixtures/VehiclePricingDomain.php",
            "tests/Fixtures/SubscriptionBillingDomain.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MathiasOnea\\Rulebook\\Providers\\RulebookServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
